  "narrative": {
    "northStar": "The Comparison Dossier",
    "overview": "A quiet operational workspace built from sage paper, forest-green controls and white expert dossiers. The density supports reading requirements, evidence and candidate differences in one session. No raster assets or portraits are used.\n\nThe system UI font stack supports offline operation and familiar forms. It is a deliberate workspace choice; there is no separate display typography role.",
    "keyCharacteristics": [
      "Sage canvas and white evidence surfaces.",
      "Forest-green primary actions and selected navigation.",
      "Explicit labels, factual status text and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Evidence Accent Rule",
        "body": "Forest green marks actions, selection and coverage; factual prose keeps the quieter ink colors.",
        "section": "colors"
      },
      {
        "name": "The Paper Layer Rule",
        "body": "Use tonal separation and borders for workspace depth.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the sage-paper, white-dossier and forest-action relationship.",
      "Do keep labels and factual text alongside color-coded status.",
      "Do retain visible focus and reduced-motion support.",
      "Do let long comparison content scroll horizontally on narrow screens."
    ],
    "donts": [
      "Don't add fabricated portraits, contact details or decorative metric claims.",
      "Don't describe coverage as a probability of suitability.",
      "Don't introduce shadows as the default surface separator."
    ]
  }
